{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CardID Pro",
        "authorizedRedirectUris": [
          "https://card-id-app.web.app",
          "https://card-id-app.firebaseapp.com",
          "localhost"
        ]
      }
    }
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/identifyCard",
        "function": {
          "functionId": "identifyCard",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/comps",
        "function": {
          "functionId": "getEbayComps",
          "region": "us-central1"
        }
      },
      {
        "source": "/companion**",
        "destination": "/companion.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ]
}
