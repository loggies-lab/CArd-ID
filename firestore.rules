rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['admin@cardid.pro', 'logan@cardid.pro'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Top-level Mobile QR Scan Sessions
    match /scanSessions/{sessionId} {
      allow read, write: if true;
    }

    // Payments and Subscriptions Collection (for Income & Admin Dashboard)
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    // User Profile Document and Isolated Subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());

      match /cards/{cardId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /batches/{batchId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      match /scanSessions/{sessionId} {
        allow read, write: if true;
      }
    }
  }
}

